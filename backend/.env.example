# TalentIQ AI - Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK Configuration
# Project ID is already known: talentiq-ai
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=talentiq-ai

# Option A: Service Account JSON file path (recommended for production)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=/path/to/talentiq-ai-service-account.json

# Option B: Set GOOGLE_APPLICATION_CREDENTIALS env var (alternative)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/talentiq-ai-service-account.json

# ──────────────────────────────────────────────────────────────────────────────
# CORS - Allowed Origins
# Comma-separated list of allowed frontend origins
# ──────────────────────────────────────────────────────────────────────────────
# For production, set only your actual deployed frontend URL:
# ALLOWED_ORIGINS=["https://your-app.web.app","https://your-custom-domain.com"]

# ──────────────────────────────────────────────────────────────────────────────
# File Storage
# Development: uses local filesystem (./storage/uploads)
# Production: configure cloud storage (e.g., GCS, S3) — see SECURITY.md
# ──────────────────────────────────────────────────────────────────────────────
# UPLOAD_DIR=/path/to/secure/uploads   # defaults to backend/storage/uploads
MAX_UPLOAD_SIZE_BYTES=15728640         # 15 MB

# ──────────────────────────────────────────────────────────────────────────────
# Optional: External AI/LLM API Keys
# If omitted, rule-based fallback is used for interview question generation.
# The system clearly labels output as RULE_ENGINE_FALLBACK when no LLM is used.
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Default Scoring Weights (must sum to 100)
# ──────────────────────────────────────────────────────────────────────────────
DEFAULT_REQUIRED_SKILLS_WEIGHT=40.0
DEFAULT_EXPERIENCE_WEIGHT=25.0
DEFAULT_PROJECTS_WEIGHT=20.0
DEFAULT_EDUCATION_CERTS_WEIGHT=15.0
