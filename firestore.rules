rules_version = '2';
//
// TalentIQ AI - Cloud Firestore Security Rules
//
// IMPORTANT: The backend uses Firebase Admin SDK which BYPASSES these rules.
// These rules serve as a defense-in-depth layer for any direct client-to-Firestore
// access attempts. All production writes go through the verified backend API.
//
// Authorization logic is enforced server-side in app/core/security.py.
//
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ──────────────────────────────────────────────────────────────────────

    // Only authenticated users may access data
    function isAuthenticated() {
      return request.auth != null;
    }

    // Resource is owned by the requesting user
    function isOwner(resource) {
      return resource.data.ownerId == request.auth.uid;
    }

    // Request data claims ownership by the requesting user
    function claimsOwnership() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    // ──────────────────────────────────────────────────────────────────────
    // Users Collection
    // Users may only read and write their own profile document.
    // ──────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────────────────────────────
    // Jobs Collection
    // Users may only CRUD their own jobs.
    // ──────────────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && claimsOwnership();
      allow update: if isAuthenticated() && isOwner(resource) && claimsOwnership();
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ──────────────────────────────────────────────────────────────────────
    // Resumes Collection
    // Users may only access their own resume records.
    // File bytes are stored locally on the backend — not in Firestore.
    // ──────────────────────────────────────────────────────────────────────
    match /resumes/{resumeId} {
      allow read: if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && claimsOwnership();
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ──────────────────────────────────────────────────────────────────────
    // Screening Runs Collection
    // ──────────────────────────────────────────────────────────────────────
    match /screeningRuns/{runId} {
      allow read: if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && claimsOwnership();
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ──────────────────────────────────────────────────────────────────────
    // Candidate Results Collection
    // ──────────────────────────────────────────────────────────────────────
    match /candidateResults/{resultId} {
      allow read: if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && claimsOwnership();
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ──────────────────────────────────────────────────────────────────────
    // Interview Question Sets Collection
    // ──────────────────────────────────────────────────────────────────────
    match /interviewQuestionSets/{setId} {
      allow read: if isAuthenticated() && isOwner(resource);
      allow create: if isAuthenticated() && claimsOwnership();
      allow update: if isAuthenticated() && isOwner(resource);
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ──────────────────────────────────────────────────────────────────────
    // Activity Logs Collection
    // Read-only for the owning user; write only via Admin SDK (backend).
    // ──────────────────────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && isOwner(resource);
      allow write: if false; // Admin SDK only
    }

    // ──────────────────────────────────────────────────────────────────────
    // Deny all other paths by default
    // ──────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
