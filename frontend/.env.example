# TalentIQ AI - Frontend Environment Variables
# Copy this file to .env.local and fill in your actual Firebase values.
# NEVER commit .env.local to version control.

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Web App Configuration
# Obtain these from: Firebase Console → Project Settings → Your apps → Web app
# Project ID: talentiq-ai
# ──────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=talentiq-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talentiq-ai
VITE_FIREBASE_STORAGE_BUCKET=talentiq-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# ──────────────────────────────────────────────────────────────────────────────
# Backend API
# Point to your local dev server or deployed backend
# ──────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
